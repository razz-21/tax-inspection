{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx nx build inspector-web --configuration=production",
  "outputDirectory": "dist/apps/inspector-web/browser",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
