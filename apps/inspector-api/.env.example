# inspector-api environment template — copy to .env and fill in real values.

# --- Database ---
# Local dev can use a plain mongodb:// URI. For Vercel/production use a
# MongoDB Atlas (mongodb+srv://) connection string.
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/?ssl=true&replicaSet=<rs>&authSource=admin
MONGODB_DB_NAME=tax-inspection-dev
PORT=3000

# --- Auth (JWT) ---
# Generate strong secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Token lifetimes in seconds (optional — these are the defaults).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
