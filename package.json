{
  "name": "tax-inspection",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx run-many -t serve -p inspector-web inspector-api",
    "dev": "nx run-many -t serve -p inspector-web inspector-api",
    "dev:web": "nx serve inspector-web",
    "dev:api": "nx serve inspector-api",
    "build": "nx run-many -t build -p inspector-web inspector-api",
    "build:web": "nx build inspector-web",
    "build:api": "nx build inspector-api",
    "build:api:vercel": "esbuild apps/inspector-api/src/app.ts --bundle --platform=node --format=cjs --packages=external --alias:@tax-inspection/shared=./libs/shared/src/index.ts --outfile=dist/inspector-api-vercel/app.cjs",
    "vercel-build": "nx build inspector-web --configuration=production && npm run build:api:vercel",
    "migrate:delivery-status": "esbuild apps/inspector-api/src/scripts/backfill-delivery-status.ts --bundle --platform=node --format=cjs --packages=external --outfile=tmp/backfill-delivery-status.cjs && node tmp/backfill-delivery-status.cjs"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@nx/angular": "^23.2.0",
    "@nx/esbuild": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/web": "23.2.0",
    "@schematics/angular": "~22.1.0",
    "@spartan-ng/cli": "^1.4.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@angular/animations": "~22.1.0",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@angular/service-worker": "~22.1.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@spartan-ng/brain": "^1.4.1",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "luxon": "^3.7.2",
    "mongodb": "^7.6.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
